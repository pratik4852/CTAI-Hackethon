# MEPIQ configuration — copy to .env. Everything here has a working default.

# --- storage -----------------------------------------------------------------
# Uploads, analysis results, SQLite and the learned symbol library all live here.
# This is the only state the application has: back it up and you have backed up
# everything.
MEPIQ_DATA_DIR=/data

# --- limits ------------------------------------------------------------------
MEPIQ_MAX_UPLOAD_MB=200
MEPIQ_MAX_SHEETS=40
# Each concurrent job holds a sheet's geometry in memory, so this is bounded by
# RAM rather than by CPU.
MEPIQ_WORKERS=2

# --- serving -----------------------------------------------------------------
# Only needed when the frontend is served from a different origin than the API.
MEPIQ_CORS_ORIGINS=*
# Set in the single-container image so the API also serves the React bundle.
# Leave unset when nginx serves the frontend (docker-compose).
# MEPIQ_STATIC_DIR=/app/static

# --- copilot (optional) ------------------------------------------------------
# Without a key the copilot still answers, using a deterministic query engine
# over the same tools. With one, the model handles open-ended reasoning too.
# NOTE: this file is committed to git. Put real keys in .env, which is not.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Azure OpenAI or an OpenAI-compatible gateway:
# OPENAI_BASE_URL=

# --- local ports and network binding (docker-compose only) -------------------
MEPIQ_WEB_PORT=8080
MEPIQ_API_PORT=8000

# Which address the published ports bind to.
#   0.0.0.0   reachable from other machines on the network (default)
#   127.0.0.1 this machine only
# You do not need to put your own IP here — 0.0.0.0 covers every interface, and
# the frontend uses relative URLs, so it works on whatever address a visitor
# types. Pin a specific IP only if the machine is on several networks and you
# want to expose just one of them.
MEPIQ_BIND=0.0.0.0
